{
  "template_id": "t3",
  "name": "黄白字幕 T3",
  "version": "1.0",
  "description": "自动BGM和声音特效，自动画面动画,关键词高亮",
  "preview_video_url": "https://static-1251729840.cos.ap-guangzhou.myqcloud.com/ai/preview/t3.mp4",
  "cover_image_url":"https://static-1251729840.cos.ap-guangzhou.myqcloud.com/ai/preview/t3.jpg",
  "auto_bgm": true,
  "project_settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 30,
    "background": "#000000",
    "bgm_category":"通用"
  },
  
  "global_elements": {
    "h1": {
      "content": "{{h1_content}}",
      "style": {
        "fontSize": 125,
        "fontFamily": "思源宋体",
        "color": "#EA8439",
        "position": [540, 80],
        "bold": true,
        "shadow": {
          "color": "#000000",
          "distance": 4,
          "opacity":0.8
        }
      },
      "animation": "{{h1_animation}}",
      "animation_options": [],
      "animation_duration": 0.8,
      "duration": 5 
    },
    "h2": {
      "content": "{{h2_content}}",
      "style": {
        "fontSize": 120,
        "fontFamily": "思源宋体",
        "color": "#FFFFFF",
        "position": [540, 200],
        "shadow": {
          "color": "#000000",
          "distance": 4,
          "opacity":0.8
        }
      },
      "animation": "{{h2_animation}}",
      "animation_options": [],
      "animation_duration": 0.6,
      "duration": 5  
    },
    "background_image":{
        "src": "black_bg.png",
        "start": 0,
        "duration": 5,
        "position": "center-top",
        "width": "100%",
        "height": "300",
        "type": "image",
        "alpha":0.3
    }
  },
  
  "subtitle_config": {
    "position": [540, 1500],
    "style": {
      "fontSize": 80,
      "fontFamily": "微软雅黑",
      "color": "#FFFFFF",
      "stroke": {
        "color": "#000000",
        "width": 3
      }
    },
    "animation_options": ["fade_in","bounce_in", "vertical_fade_multi","horizontal_slide_multi"],
    "highlight_style": {
      "color": "#FFD700",
      "bold": true    
    }
  },

  "keyframe":{
    "animation_options":["中心放大","边框1"]
  }
  ,
  "pip_config": {
    "position": "center",
    "scale": 1
  },
  
  "content_prompts": {
    "h1": "请生成一个吸引人的主标题,8个字以内,且不要有标点，如：世界上最好的养生",
    "h2": "生成一个简洁的副标题，且不要有标点，6个字以内，如：是情绪稳定 ",
    "subtitles": "按照以下要求处理字幕信息：注意：断句的组合字幕必须用组合动画vertical_fade_multi、horizontal_slide_multi二选一。"
  }
}